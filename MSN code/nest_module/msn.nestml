# MSN (Medium Spiny Neuron) model
# ################################
#
# Custom Izhikevich-based model with conductance-based synapses,
# NMDA magnesium block, and dopaminergic modulation (D1/D2).
# Adapted from Gonzalez et al. (2020).
#
model msn_neuron:

    state:
        V_m mV = -65.0 mV # Membrane potential 
        U_m real = 0.0
        I pA = 0.0 pA    # input current
        dop real = 0.0  # Used for reset after the spike

    equations:
        kernel kernel_ampa = exp(-t / tau_decay_AMPA)
        kernel kernel_nmda = exp(-t / tau_decay_NMDA)
        kernel kernel_gaba = exp(-t / tau_decay_GABA_A)

        inline g_ampa nS = convolve(kernel_ampa, spikes_ampa) * 1 nS
        inline g_nmda nS = convolve(kernel_nmda, spikes_nmda) * 1 nS
        inline g_gaba nS = convolve(kernel_gaba, spikes_gaba) * 1 nS

        inline ampa pA = g_ampa * (E_rev_AMPA - V_m)
        inline nmda pA = g_nmda * (E_rev_NMDA - V_m)
        inline I_gaba pA = g_gaba * (E_rev_GABA_A - V_m)

        inline I_nmda pA = nmda * (1.0 + beta_1 * phi_1)
        inline I_ampa pA = ampa * (1.0 - beta_2 * phi_2)
        inline B real = 1.0 / (1.0 + (0.28) * exp(-0.062 * V_m))

        inline I_syn pA = I_ampa + B * I_nmda + I_gaba
        inline v_r mV = vp * (1.0 + K_d1 * phi_1)
        inline k real = Kplus * (1.0 - alpha * phi_2)

        V_m' = (k * (V_m - v_r) * (V_m - V_T) / 1 mV - U_m * 1 mV + ((I + I_e + I_syn) * 1 GOhm)) / (C_m * (1 ms / 1 pF))
        U_m' = a * (b * (V_m - v_r) - U_m * 1 mV) / (1 mV * 1 ms)

    parameters:
        a real = 0.03
        b real = -2.0
        c mV = -50 mV
        d real = 100
        I_e pA = 0 pA           # constant external input current
        V_th mV = 35 mV         # V peak
        V_min mV = -inf * 1 mV  # lower bound of membrane potential
        Kplus real = 0.7
        vp mV = -60.0 mV        # resting potential
        V_T mV = -40.0 mV       # threshold potential
        C_m pF = 100.0 pF       # membrane capacitance
        K_d1 real = 0.0289      # K (inward rectifying K+ current)
        L_d1 real = 0.331       # L (L-type Ca2+ activation)
        phi_1 real = 0.3        # fraction of active D1 receptors
        phi_2 real = 0.3        # fraction of active D2 receptors
        beta_1 real = 0.5       # NMDA enhancement factor
        beta_2 real = 0.5       # AMPA reduction factor
        alpha real = 0.032      # current attenuation factor
        tau_decay_AMPA ms = 2.0 ms
        tau_decay_GABA_A ms = 2.0 ms
        tau_decay_NMDA ms = 2.0 ms
        E_rev_AMPA mV = 0.0 mV
        E_rev_GABA_A mV = 0.0 mV
        E_rev_NMDA mV = 0.0 mV

    input:
        spikes_ampa <- spike
        spikes_nmda <- spike
        spikes_gaba <- spike
        I_stim pA <- continuous

    output:
        spike

    update:
        integrate_odes()

        # lower bound of membrane potential
        V_m = max(V_min, V_m)

    onCondition(V_m >= 30 mV):
        # threshold crossing
        dop = d * (1.0 - L_d1 * phi_1)
        V_m = c
        U_m += dop
        emit_spike()
